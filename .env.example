# Optional. The complete local game works with all of these empty.
# Copy this file to .env.local and fill keys locally, never in chat.
# These three credentials are read ONLY by the Node asset CLI.
WORLDLABS_API_KEY=
WORLDLABS_MODEL=marble-1.1
TRIPO_API_KEY=
TRIPO_MODEL=v3.1-20260211
MINT_API_KEY=

# Public deployment address, NOT an API secret. npx convex dev supplies it.
VITE_CONVEX_URL=
